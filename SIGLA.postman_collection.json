                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "const j = pm.response.json();",
                  "pm.test('Formato único de error', () => pm.expect(j.error).to.eql('Datos inválidos'));",
                  "pm.test('Lista todos los campos que fallaron', () => {",
                  "  const campos = j.detalles.map(d => d.campo);",
                  "  pm.expect(campos).to.have.members(['nombre', 'tipo_cobro', 'precio']);",
                  "  j.detalles.forEach(d => pm.expect(d.mensaje).to.be.a('string').and.not.empty);",
