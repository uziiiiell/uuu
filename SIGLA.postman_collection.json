{
  "info": {
    "name": "SIGLA · API de Lavandería",
    "description": "Colección de pruebas. Ejecutar con el Runner sobre una base recién creada: npm run db, npm run semilla, npm start. Hito 2: salud, autenticación, servicios, clientes y prendas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Salud y autenticación",
      "item": [
        {
          "name": "Salud de la API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('La respuesta es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('La API y la base responden', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.estado).to.eql('ok');",
                  "  pm.expect(j.base_datos).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/api/salud",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve token, expira_en y usuario admin', () => {",
                  "  pm.expect(j.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(j.expira_en).to.eql('2h');",
                  "  pm.expect(j.usuario.rol).to.eql('admin');",
                  "});",
                  "pm.test('Nunca devuelve el hash', () => pm.expect(pm.response.text()).to.not.include('hash'));",
                  "pm.collectionVariables.set('token_admin', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
