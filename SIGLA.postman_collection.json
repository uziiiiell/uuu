        {
          "name": "Listar servicios con paginación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Trae datos y paginacion', () => {",
                  "  pm.expect(j.datos).to.be.an('array').with.length.of.at.most(2);",
                  "  pm.expect(j.paginacion).to.have.all.keys('pagina', 'limite', 'total', 'paginas');",
                  "  pm.expect(j.paginacion.limite).to.eql(2);",
                  "});",
                  "pm.test('Ordenado por precio de mayor a menor', () => {",
                  "  const p = j.datos.map(s => s.precio);",
                  "  pm.expect(p).to.eql([...p].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
